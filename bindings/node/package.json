{
  "name": "@packvium/native",
  "version": "1.8.0",
  "description": "Compiled Rust engine for @packvium/engine. Not meant to be installed directly.",
  "license": "MIT",
  "main": "index.js",
  "files": [
    "index.js",
    "index.d.ts"
  ],
  "types": "index.d.ts",
  "napi": {
    "binaryName": "packvium-native",
    "targets": [
      "aarch64-apple-darwin",
      "x86_64-apple-darwin",
      "x86_64-pc-windows-msvc",
      "x86_64-unknown-linux-gnu"
    ]
  },
  "author": {
    "name": "Packvium",
    "url": "https://packvium.com"
  },
  "homepage": "https://packvium.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/toxakara/packvium-native.git"
  },
  "bugs": {
    "url": "https://github.com/toxakara/packvium-native/issues"
  },
  "optionalDependencies": {
    "@packvium/native-darwin-arm64": "1.8.0",
    "@packvium/native-darwin-x64": "1.8.0",
    "@packvium/native-win32-x64-msvc": "1.8.0",
    "@packvium/native-linux-x64-gnu": "1.8.0"
  }
}
